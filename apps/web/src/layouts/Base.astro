---
import '../styles/global.css';
import Atmos from '../components/Atmos.astro';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'pythonjs.org — A developer studio for products, automation & brand',
  description = 'A team of developers building products, automations and online presence — engineered end to end.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f5efe8" />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />

    <!-- Fonts: production families only (Bricolage / Hanken / JetBrains Mono) -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Bricolage+Grotesque:opsz,wght@12..96,500;12..96,600;12..96,700;12..96,800&family=Hanken+Grotesk:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />

    <!-- Anti-flash: set theme before paint (key: pyjs.theme, default: prefers-color-scheme) -->
    <script is:inline>
      (function () {
        var r = document.documentElement;
        try {
          var t = localStorage.getItem('pyjs.theme');
          if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
          r.setAttribute('data-theme', t);
        } catch (e) {}
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#top">Skip to content</a>
    <Atmos />
    <Nav />
    <slot />
    <Footer />

    <script>
      import '../scripts/interactions.ts';
    </script>
  </body>
</html>
