---
// Hero — kicker, reveal headline, sub + actions, scoping card, marquee strip.
---
<section class="hero">
  <div class="hero-spot" id="heroSpot"></div>
  <div class="wrap">
    <div class="hero-top reveal">
      <span class="chip live"><span class="led"></span>Available for new projects</span>
      <span class="sep"></span>
      <span class="kicker">A developer studio</span>
    </div>
    <h1>
      <span class="ln reveal" data-d="1"><span>We build the</span></span>
      <span class="ln reveal" data-d="2"><span><span class="it">software</span> &amp; systems</span></span>
      <span class="ln reveal" data-d="3"><span>behind your brand.</span></span>
    </h1>
    <div class="hero-bottom">
      <div>
        <p class="hero-sub reveal" data-d="3">
          A small team of engineers &amp; designers. We ship products, wire up automations,
          and put businesses online — then make the whole machine run itself.
        </p>
        <div class="hero-actions reveal" data-d="4">
          <a class="btn btn-primary magnetic" href="#work">See the work <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <a class="btn btn-ghost magnetic" href="#contact">Start a project</a>
        </div>
      </div>
      <div class="hero-aside hero-aside--tuck reveal" data-d="4">
        <div class="hero-card">
          <div class="hc-top">
            <span class="hc-label">start a project</span>
            <span class="chip live"><span class="led"></span>2 slots open</span>
          </div>
          <ol class="hc-steps">
            <li>
              <i>01</i>
              <div><b>Tell us the problem</b><span>a 20-minute call — no prep needed</span></div>
            </li>
            <li>
              <i>02</i>
              <div><b>We design &amp; build it</b><span>scoped and priced up front, shipped fast</span></div>
            </li>
            <li>
              <i>03</i>
              <div><b>It runs on its own</b><span>you get your hours back, we keep it healthy</span></div>
            </li>
          </ol>
          <a class="btn btn-primary hc-cta" href="#contact">Book a free scoping call <svg class="arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></a>
          <div class="hc-note">We reply within 24 hours</div>
        </div>
      </div>
    </div>
  </div>

  <!-- marquee -->
  <div class="strip" aria-hidden="true">
    <div class="strip-row" id="strip">
      <span class="strip-item">Products</span>
      <span class="strip-item">Automation</span>
      <span class="strip-item">Web Apps</span>
      <span class="strip-item">Brand &amp; Identity</span>
      <span class="strip-item">APIs</span>
      <span class="strip-item">Dashboards</span>
      <span class="strip-item">AI Workflows</span>
    </div>
  </div>
</section>
