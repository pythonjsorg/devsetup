---
// Selected work — bento grid with cursor-spotlight tiles (wired in interactions.ts).
import { Image } from 'astro:assets';
import lcLight from '../assets/work/localconnect-light.png';
import lcDark from '../assets/work/localconnect-dark.png';
---
<section class="sec" id="work">
  <div class="wrap">
    <div class="sec-head">
      <div class="reveal">
        <span class="kicker">Selected work</span>
        <h2 class="sec-title">Real problems we've shipped solutions for.</h2>
      </div>
      <p class="lead reveal" data-d="1">Client work and our own products — built end to end, running in production.</p>
    </div>

    <div class="bento">
      <article class="tile tile-wide reveal">
        <div class="spotlight"></div>
        <div class="tile-viz"><span class="ring"></span><span class="ring"></span><span class="ring"></span></div>
        <div class="tile-top">
          <div class="tile-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 19V5M4 19h16M8 16l3-4 3 2 4-6"/></svg></div>
          <span class="chip live"><span class="led"></span>Client work · Live</span>
        </div>
        <h3>Monitoring, unified</h3>
        <p>Our client had dozens of websites, domains, pages and APIs — and no way to watch them all. We built one system that monitors every endpoint and raises the alarm before their users ever notice.</p>
        <div class="tile-foot">
          <span class="tile-metric"><b>Sites, domains &amp; APIs</b> — one dashboard</span>
          <span class="soon-tag">Case study soon</span>
        </div>
      </article>

      <a
        class="tile tile-tall has-shot reveal"
        data-d="1"
        href="https://localconnectpro.com"
        target="_blank"
        rel="noopener"
        aria-label="Local Connect — visit localconnectpro.com"
      >
        <div class="spotlight"></div>
        <div class="tile-top">
          <div class="tile-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 21s-7-5.1-7-10a7 7 0 0114 0c0 4.9-7 10-7 10z"/><circle cx="12" cy="11" r="2.5"/></svg></div>
          <span class="chip live"><span class="led"></span>Client work · Live</span>
        </div>
        <div class="tile-shot">
          <Image src={lcLight} alt="LocalConnect Pro homepage" class="shot shot-light" width={760} densities={[1, 2]} />
          <Image src={lcDark} alt="LocalConnect Pro homepage — dark mode" class="shot shot-dark" width={760} densities={[1, 2]} />
        </div>
        <h3>Local Connect</h3>
        <p>A platform connecting local businesses with the people around them — scoped, built and shipped in two weeks.</p>
        <div class="tile-foot">
          <span class="tile-metric"><b>2 weeks</b> idea → launch</span>
          <span class="visit">localconnectpro.com <svg class="arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg></span>
        </div>
      </a>

      <article class="tile tile-half reveal" data-d="1">
        <div class="spotlight"></div>
        <div class="tile-top">
          <div class="tile-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M4 19.5A2.5 2.5 0 016.5 17H20V4H6.5A2.5 2.5 0 004 6.5v13z"/><path d="M4 19.5A2.5 2.5 0 006.5 22H20v-5"/></svg></div>
          <span class="chip"><span class="led"></span>Our product</span>
        </div>
        <h3>Developer training</h3>
        <p>Our own platform for training developers in programming and AI — so they can build systems that are secure from day one.</p>
        <div class="tile-foot">
          <span class="tile-metric">For <b>users &amp; fellow devs</b></span>
          <a class="tlink" href="#docs">Resources <svg class="arrow" viewBox="0 0 24 24" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg></a>
        </div>
      </article>

      <article class="tile tile-half reveal" data-d="2">
        <div class="spotlight"></div>
        <div class="tile-top">
          <div class="tile-ico"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6"><path d="M12 3l8 3v6c0 4.4-3.2 7.7-8 9-4.8-1.3-8-4.6-8-9V6l8-3z"/><path d="M9 12l2 2 4-4"/></svg></div>
          <span class="chip dev"><span class="led"></span>In build</span>
        </div>
        <h3>Security, simplified</h3>
        <p>Security tooling anyone can drop into their systems — real protection without needing deep cyber-security expertise.</p>
        <div class="tile-foot">
          <span class="tile-metric"><b>Coming</b> soon</span>
        </div>
      </article>
    </div>
  </div>
</section>
