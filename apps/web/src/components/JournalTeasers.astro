---
// Journal teasers — blog post cards linking to the published /journal articles.
import { Image } from 'astro:assets';
import lcLight from '../assets/journal/localconnect-light.png';
import lcDark from '../assets/journal/localconnect-dark.png';
---
<section class="sec" id="journal">
  <div class="wrap">
    <div class="sec-head">
      <div class="reveal">
        <span class="kicker">Journal</span>
        <h2 class="sec-title">Building in the open.</h2>
      </div>
      <p class="lead reveal" data-d="1">Notes on what we're shipping, learning and breaking.</p>
    </div>
    <div class="posts">
      <a class="post reveal" href="/journal/monitoring-without-alert-fatigue">
        <div class="post-cover"><span class="pattern"></span><span class="pc-label">Monitoring / alerts</span></div>
        <div class="post-body">
          <div class="post-meta"><span class="post-cat">Engineering</span><span>·</span><span>Mar 18, 2026</span><span>·</span><span>9 min</span></div>
          <h3>Monitoring dozens of sites &amp; APIs without drowning in alerts</h3>
          <p>How we unified a client's domains, pages and endpoints into one calm dashboard.</p>
          <span class="post-go">Read article <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </div>
      </a>
      <a class="post reveal" data-d="1" href="/journal/the-automation-audit">
        <div class="post-cover"><span class="pattern"></span><span class="pc-label">Playbook / audit</span></div>
        <div class="post-body">
          <div class="post-meta"><span class="post-cat">Playbook</span><span>·</span><span>Feb 27, 2026</span><span>·</span><span>7 min</span></div>
          <h3>The automation audit we run for every new client</h3>
          <p>Five questions that reveal where the hours are really going.</p>
          <span class="post-go">Read article <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M5 12h14M13 6l6 6-6 6"/></svg></span>
        </div>
      </a>
      <a class="post reveal" data-d="2" href="https://localconnectpro.com" target="_blank" rel="noopener">
        <div class="post-cover">
          <Image src={lcLight} alt="LocalConnect Pro homepage" class="shot shot-light" width={640} densities={[1, 2]} />
          <Image src={lcDark} alt="LocalConnect Pro homepage — dark mode" class="shot shot-dark" width={640} densities={[1, 2]} />
        </div>
        <div class="post-body">
          <div class="post-meta"><span class="post-cat">Case study</span><span>·</span><span>Live</span></div>
          <h3>Shipping Local Connect in two weeks — on weekends</h3>
          <p>How tight scoping let us take a marketplace from idea to launch, fast.</p>
          <span class="post-go">Visit site <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17L17 7M9 7h8v8"/></svg></span>
        </div>
      </a>
    </div>
  </div>
</section>
