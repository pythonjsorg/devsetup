---
// Team / about — copy + roles grid.
import { Image } from 'astro:assets';
import sanjayModi from '../assets/team/sanjay-modi.jpeg';
import backendDev from '../assets/team/backend-dev.jpeg';
---
<section class="sec" id="team">
  <div class="wrap">
    <div class="team-grid">
      <div class="team-copy reveal">
        <span class="kicker">Who we are</span>
        <h2>A small team that ships like a big one.</h2>
        <p>We started as Python developers automating tedious work, and grew into a studio that builds full products end to end. Today we help <b>small businesses, startups and teams</b> turn ideas into working software — and give them a presence they're proud of.</p>
        <p>Everything you see here we've designed, built and shipped ourselves. We work in the open and care about systems that keep running long after launch.</p>
        <div class="team-meta">
          <div class="tm"><div class="v">6</div><div class="k">developers</div></div>
          <div class="tm"><div class="v">Global</div><div class="k">remote-first</div></div>
          <div class="tm"><div class="v">24h</div><div class="k">reply time</div></div>
        </div>
      </div>
      <div class="team-faces reveal" data-d="1">
        <div class="face has-photo"><Image src={backendDev} alt="Backend developer" class="face-photo" width={560} densities={[1, 2]} style="object-position: center 52%" /><div class="nameplate"><div class="nm">Backend Developer</div><div class="rl">backend · infra</div></div></div>
        <div class="face"><span class="ph">[ photo ]</span><div class="nameplate"><div class="nm">Product Designer</div><div class="rl">ui · brand</div></div></div>
        <div class="face has-photo"><Image src={sanjayModi} alt="Sanjay Modi" class="face-photo" width={560} densities={[1, 2]} /><div class="nameplate"><div class="nm">Sanjay Modi</div><div class="rl">automation · data · bots</div></div></div>
        <div class="face"><span class="ph">[ photo ]</span><div class="nameplate"><div class="nm">Full-stack Dev</div><div class="rl">web · apps</div></div></div>
      </div>
    </div>
  </div>
</section>
