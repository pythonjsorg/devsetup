---
// Team / about — copy + 2×2 grid of flip cards (each card flips between 2 members).
import TeamFace from './TeamFace.astro';
import sanjayModi from '../assets/team/sanjay-modi.jpeg';
import adityaSuthar from '../assets/team/aditya-suthar.jpeg';
import kiranJoshi from '../assets/team/kiran-joshi.jpeg';

// Ordered so the 4 "front" faces (first 4) surface the real members up front.
const members = [
  { name: 'Aditya Suthar', role: 'backend · infra', img: adityaSuthar, pos: 'center 52%' },
  { name: 'Sanjay Modi', role: 'automation · data · bots', img: sanjayModi },
  { name: 'Kiran Joshi', role: 'SEO · ASO · content writer', img: kiranJoshi, pos: 'center 38%' },
  { name: 'Full-stack Dev', role: 'web · apps' },
  { name: 'Product Designer', role: 'ui · brand' },
  { name: 'DevOps', role: 'cloud · ci/cd' },
  { name: 'QA Engineer', role: 'testing · qa' },
  { name: 'Data Engineer', role: 'data · sql' },
];
// 4 cards, each flips between members[i] (front) and members[i+4] (back).
const cards = [0, 1, 2, 3].map((i) => [members[i], members[i + 4]]);
---
<section class="sec" id="team">
  <div class="wrap">
    <div class="team-grid">
      <div class="team-copy reveal">
        <span class="kicker">Who we are</span>
        <h2>A small team that ships like a big one.</h2>
        <p>We started as Python developers automating tedious work, and grew into a studio that builds full products end to end. Today we help <b>small businesses, startups and teams</b> turn ideas into working software — and give them a presence they're proud of.</p>
        <p>Everything you see here we've designed, built and shipped ourselves. We work in the open and care about systems that keep running long after launch.</p>
        <div class="team-meta">
          <div class="tm"><div class="v">8</div><div class="k">developers</div></div>
          <div class="tm"><div class="v">Global</div><div class="k">remote-first</div></div>
          <div class="tm"><div class="v">24h</div><div class="k">reply time</div></div>
        </div>
      </div>
      <div class="team-faces reveal" data-d="1">
        {
          cards.map((pair, i) => (
            <div class="face-flip" style={`--i: ${i}`}>
              <div class="face-flip-inner">
                <TeamFace member={pair[0]} side="front" />
                <TeamFace member={pair[1]} side="back" />
              </div>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
