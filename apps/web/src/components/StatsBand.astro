---
// Stats band — animated counters (data-count / data-suffix) wired in interactions.ts.
---
<section class="sec" style="padding-top: clamp(28px,3vw,44px);">
  <div class="wrap">
    <div class="stats reveal">
      <div class="stat"><div class="num" data-count="40" data-suffix="+">0</div><div class="lab">Projects shipped</div></div>
      <div class="stat"><div class="num" data-count="6" data-suffix="yr">0</div><div class="lab">Building together</div></div>
      <div class="stat"><div class="num" data-count="24" data-suffix="h">0</div><div class="lab">Typical reply time</div></div>
      <div class="stat"><div class="num" data-count="100" data-suffix="%">0</div><div class="lab">Built in-house</div></div>
    </div>
  </div>
</section>
