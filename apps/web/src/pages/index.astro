---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import StatsBand from '../components/StatsBand.astro';
import WorkBento from '../components/WorkBento.astro';
import ServicesAccordion from '../components/ServicesAccordion.astro';
import Team from '../components/Team.astro';
import DocsGrid from '../components/DocsGrid.astro';
import JournalTeasers from '../components/JournalTeasers.astro';
import ContactCard from '../components/ContactCard.astro';
---
<Base>
  <main id="top" tabindex="-1">
    <Hero />
    <StatsBand />
    <WorkBento />
    <ServicesAccordion />
    <Team />
    <DocsGrid />
    <JournalTeasers />
    <ContactCard />
  </main>
</Base>
